rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /profiles/{uid} {
      allow get: if signedInAs(uid);
      allow list, delete: if false;
      allow create, update: if signedInAs(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{uid}/favourites/{fontId} {
      allow get, list: if signedInAs(uid);
      allow create, update: if signedInAs(uid)
        && request.resource.data.keys().hasOnly(['fontId', 'createdAt'])
        && request.resource.data.fontId == fontId
        && request.resource.data.createdAt == request.time;
      allow delete: if signedInAs(uid);
    }

    match /users/{uid}/drafts/{draftId} {
      allow get, list: if signedInAs(uid);
      allow create: if signedInAs(uid)
        && request.resource.data.keys().hasOnly(['title', 'text', 'updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 200000
        && request.resource.data.updatedAt == request.time;
      allow update: if signedInAs(uid)
        && request.resource.data.keys().hasOnly(['title', 'text', 'updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 200000
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedInAs(uid);
    }

    match /roleChanges/{changeId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
